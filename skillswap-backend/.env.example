# Copy this file to .env before starting Docker Compose.
# Run from the repository root:
# docker compose --env-file ./skillswap-backend/.env up --build

# Database
# Use a URL-safe password (letters, numbers, and hyphens) for POSTGRES_PASSWORD.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
POSTGRES_DB=skillswap
POSTGRES_EXPOSED_PORT=5433
# Used for local development; Compose builds the internal URL from the values above.
DATABASE_URL=postgresql://postgres:replace-with-a-strong-url-safe-password@localhost:5433/skillswap

# JWT authentication
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin
SUPER_ADMIN_EMAIL=admin@example.com

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_EXPIRE=600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Application
ENVIRONMENT=development
VERIFICATION_PASS_PERCENTAGE=60.0
JITSI_BASE_URL=https://meet.jit.si

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=SkillSwap <no-reply@example.com>

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-a-minio-user
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_BUCKET=skillswap
MINIO_SECURE=false
