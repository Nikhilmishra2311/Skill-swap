# Database (local development; Docker Compose uses service hostnames internally)
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/skillswap

# JWT authentication
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin
SUPER_ADMIN_EMAIL=admin@example.com

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_EXPIRE=600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Application
ENVIRONMENT=development
VERIFICATION_PASS_PERCENTAGE=60.0
JITSI_BASE_URL=https://meet.jit.si

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=SkillSwap <no-reply@example.com>

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# MinIO (local development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=skillswap
MINIO_SECURE=false
